# Python 3.11+ only. Copy to sshintel.toml and protect it with chmod 600.
# On Python 3.8/3.10 use sshintel.json.example instead (no extra dependency).
host = "0.0.0.0"
port = 2222
username = "user1"
password = "pass123"
tarpit = false
tarpit_max_seconds = 120
max_connections = 50
auth_timeout = 60
session_idle_timeout = 300
sensor_id = "sensor-01"
db_path = "data/sshintel.db"
no_db = false
# Reserved: actual payload fetching is not implemented. Must remain false.
fetch_payloads = false