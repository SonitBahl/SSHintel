# Python bytecode / cache
__pycache__/
*.py[cod]
*.pyo

# Runtime logs generated by the honeypot
log_files/*
!log_files/.gitkeep

# SQLite telemetry databases (runtime data)
data/
*.db
*.db-shm
*.db-wal

# Generic log files
*.log

# Virtual environments
.env
.venv/
venv/

# SSH host keys generated at runtime
static/server.key
static/server.key.pub

# Test / coverage artifacts
.coverage
coverage.xml
htmlcov/
.pytest_cache/